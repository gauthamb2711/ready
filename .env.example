# ==============================================================================
# READY SaaS Platform - Local Environment Configuration (.env.local)
# ==============================================================================
# Instructions for running in local VS Code / localhost:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Fill in your Supabase project credentials below.
# 3. Ensure your Supabase Dashboard -> Authentication -> URL Configuration
#    includes http://localhost:3000/** and http://localhost:3000/auth/callback in Redirect URLs.
# 4. DO NOT commit .env.local or any sensitive API keys to git.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://btnogpdzwkplhplqbgwf.supabase.co

# Supabase Publishable / Anon API Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Base Application URL (Used for email confirmation links, auth callbacks, and redirects)
# Set to http://localhost:3000 for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
